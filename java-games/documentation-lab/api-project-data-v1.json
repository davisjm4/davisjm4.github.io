  "scenarios": [
    {
      "id": "album-viewer",
      "providerId": "dev-tunebox",
      "title": "Album Viewer",
      "goal": "Build the request plan for an album viewer. The application needs the album title, artist name, cover image, and complete song list.",
      "requirements": [
        {
          "id": "album-title",
          "label": "Album title",
          "description": "The title displayed at the top of the page."
        },
        {
          "id": "artist-name",
          "label": "Artist name",
          "description": "The artist's display name, not only its identifier."
        },
        {
          "id": "cover-image",
          "label": "Cover image",
          "description": "The URL for the album cover image."
        },
        {
          "id": "song-list",
          "label": "Song list",
          "description": "Every track title in the album."
        }
      ],
      "constraints": {
        "text": "Use the smallest sufficient set of requests. The album identifier is ALB-42.",
        "optimize": "smallest-sufficient"
      },
      "availableEndpointIds": [
        "album-get",
        "album-tracks",
        "artist-get",
        "artist-albums"
      ],
      "acceptedPlans": [
        {
          "id": "album-viewer-smallest",
          "efficiency": "smallest-sufficient",
          "requests": [
            {
              "endpointId": "album-get",
              "parameters": {
                "albumId": "ALB-42"
              }
            },
            {
              "endpointId": "album-tracks",
              "parameters": {
                "albumId": "ALB-42"
              }
            },
            {
              "endpointId": "artist-get",
              "parameters": {
                "artistId": "ART-7"
              }
            }
          ]
        }
      ],
      "explanation": "Get one album supplies the title, cover image, artist identifier, and track references. The artist request turns ART-7 into the display name. The tracks collection supplies every track title. The artist-albums collection cannot replace the album request because it does not provide the selected album's complete details.",
      "responseSamples": [
        {
          "endpointId": "album-get",
          "body": {
            "id": "ALB-42",
            "title": "Midnight Signals",
            "artistId": "ART-7",
            "coverImage": "/covers/midnight-signals.jpg",
            "trackIds": [
              "TR-1",
              "TR-2"
            ]
          }
        },
        {
          "endpointId": "artist-get",
          "body": {
            "id": "ART-7",
            "name": "The Night Shift",
            "image": "/artists/night-shift.jpg"
          }
        },
        {
          "endpointId": "album-tracks",
          "body": {
            "items": [
              {
                "id": "TR-1",
                "title": "Afterglow",
                "durationSeconds": 214
              },
              {
                "id": "TR-2",
                "title": "Static Hearts",
                "durationSeconds": 198
              }
            ]
          }
        }
      ],
      "modelTargets": [
        {
          "id": "album",
          "concept": "Album",
          "fields": [
            "title",
            "coverImage"
          ],
          "relationships": [
            "artist",
            "tracks"
          ]
        },
        {
          "id": "artist",
          "concept": "Artist",
          "fields": [
            "name"
          ],
          "relationships": []
        },
        {
          "id": "track",
          "concept": "Track",
          "fields": [
            "title",
            "durationSeconds"
          ],
          "relationships": []
        }
      ]
    },
