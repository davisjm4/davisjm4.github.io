        {
          "id": "album-get",
          "method": "GET",
          "path": "/v1/albums/{albumId}",
          "title": "Get one album",
          "description": "Returns the identifying information for one album, including its artist reference, cover image, and track references.",
          "parameters": [
            {
              "name": "albumId",
              "location": "path",
              "type": "string",
              "required": true,
              "description": "The album identifier."
            },
            {
              "name": "market",
              "location": "query",
              "type": "string",
              "required": false,
              "allowedValues": [
                "US",
                "CA"
              ],
              "description": "Optional market code used to choose regional availability information."
            }
          ],
          "authentication": {
            "required": false,
            "description": "No authentication is required in this classroom fixture."
          },
          "responseFields": [
            {
              "path": "id",
              "type": "string",
              "description": "The album identifier."
            },
            {
              "path": "title",
              "type": "string",
              "description": "The album title."
            },
            {
              "path": "artistId",
              "type": "string",
              "description": "Identifier of the album's artist."
            },
            {
              "path": "coverImage",
              "type": "string",
              "description": "URL of the album cover image."
            },
            {
              "path": "trackIds",
              "type": "array<string>",
              "description": "Identifiers for the album's tracks."
            }
          ],
          "sourceUrl": "https://example.invalid/tunebox-api/albums#get-one"
        },
        {
