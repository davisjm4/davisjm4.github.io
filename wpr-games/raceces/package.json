{
  "name": "raceces-writing-games",
  "version": "1.0.0",
  "private": true,
  "description": "RACECES Writing Games: a standalone, account-free academic writing practice site.",
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "scripts": {
    "build": "node tools/build.js && node tools/build-compose.js",
    "validate": "node tools/validate-content.js && node tools/validate-compose.js",
    "test:unit": "node tests/run-all.js",
    "test:browser": "node tests/browser/run.js && node tests/browser/compose-run.js",
    "sweep": "node tests/sweep.js",
    "audit:repetition": "node tools/repetition-audit.js",
    "docs": "node tools/gen-docs.js",
    "test": "npm run build && npm run validate && npm run test:unit && npm run test:compose && npm run test:browser && npm run audit:repetition && npm run audit:diversity && npm run docs",
    "test:compose": "node tests/compose/run-compose.js && node tests/compose/production-guard.js",
    "audit:diversity": "node tools/diversity-audit.js",
    "samples": "node tools/gen-samples.js"
  }
}
